{
  "name": "dsh-agentbox",
  "version": "0.1.0",
  "description": "Mobile and small-screen fixes for the DeepSeek Harness web shell, as a toggleable plugin.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "INTERNALS.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "main": "lib/index.js",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "plugin",
    "mobile",
    "responsive"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charysrinathsc/dsh-agentbox.git"
  },
  "homepage": "https://github.com/charysrinathsc/dsh-agentbox#readme",
  "bugs": {
    "url": "https://github.com/charysrinathsc/dsh-agentbox/issues"
  },
  "author": "charysrinathsc"
}
